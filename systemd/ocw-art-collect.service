# The art project's hourly collector (docs/ART-PROJECT.md §5.1): gather +
# journal of yesterday and today, the mask check, the local gallery; in the
# 23:xx run the contact sheets and the Git LFS commit of the finished days.
# Started by ocw-art-collect.timer; installed by `make install-timer` in the OCW-ART checkout, which fills in @REPO@ (that checkout).
[Unit]
Description=OCW Build Diary: hourly collector (docs/ART-PROJECT.md §5.1)

[Service]
Type=oneshot
WorkingDirectory=@REPO@
ExecStart=@REPO@/bin/collect.sh
# git, ffmpeg, flock, gh; not the pyenv shims (the script picks /usr/bin/python3).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# deb: /tmp is a tmpfs (RAM, then swap) – temp files (ffmpeg, mktemp, Python's
# tempfile) go to disk, like the build dashboard's unit (OCW's CLAUDE.md).
Environment=TMPDIR=%h/tmp
ExecStartPre=/bin/mkdir -p %h/tmp
# Up to 45 min waiting for a manual diary.py run (the lock), then the run itself.
Environment=OCW_ART_LOCK_WAIT=2700
# (+ an LFS push of up to ~1.4 GB after the 23:xx run.)
TimeoutStartSec=150min
# 75: another run held the lock (status "locked" in art.json), not a failure.
SuccessExitStatus=75
Nice=10
IOSchedulingClass=idle
